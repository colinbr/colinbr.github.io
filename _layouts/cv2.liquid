---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>

    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% if page.cv_pdf %}
        <div class="card mt-3 p-3">
          <div style="width: 100%; height: 80vh; overflow: auto; border: 1px solid var(--global-divider-color, #ccc); border-radius: 4px;">
            <iframe
              src="{% if page.cv_pdf contains '://' %}{{ page.cv_pdf }}{% else %}{{ page.cv_pdf | relative_url }}{% endif %}"
              style="width: 100%; height: 100%; border: none;"
              title="{{ page.title }}"
            >
              <p>
                Your browser doesn't support embedded PDFs.
                <a href="{% if page.cv_pdf contains '://' %}{{ page.cv_pdf }}{% else %}{{ page.cv_pdf | relative_url }}{% endif %}">
                  Download the PDF
                </a>
                instead.
              </p>
            </iframe>
          </div>
        </div>
      {% else %}
        <p>
          No CV PDF configured. Set <code>cv_pdf</code> in the page's frontmatter.
        </p>
      {% endif %}
    </div>
  </article>
</div>